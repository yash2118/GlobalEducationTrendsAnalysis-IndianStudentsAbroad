      <column caption='Growth Rate' datatype='real' name='[Calculation_0721807406374914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Students_Count]) - LOOKUP(SUM([Students_Count]),-1))&#10;/&#10;LOOKUP(SUM([Students_Count]),-1)'>
